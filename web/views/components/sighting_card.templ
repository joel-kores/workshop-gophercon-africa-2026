package components

import (
	"cmp"
	"strings"
	"workshop/internal/domain/sighting"
	"workshop/internal/domain/species"
)

templ SightingCard(s sighting.Sighting) {
	<article class="card">
		<div class="card-photo">
			if photo := firstPhoto(s.Media); photo.URL != "" {
				<img src={ templ.URL(photo.URL) } alt={ cmp.Or(photo.Title, "Wildlife observation: "+displayName(s.Species)) } loading="lazy"/>
				if photo.Creator != "" {
					<span class="photo-credit">Photo: { photo.Creator }</span>
				}
			} else {
				<div class="photo-placeholder"><img src="/assets/images/logo.svg" alt="" width="72" height="72"/><span>A moment in the wild</span><small>No photograph recorded</small></div>
			}
			<span class="location-tag">{ cmp.Or(s.Location.Country, "Kenya") }</span>
		</div>
		<div class="card-body">
			<p class="card-date">{ s.HappenedAt.Format("02 January 2006") }</p>
			<h3>{ displayName(s.Species) }</h3>
			if s.Species.ScientificName != "" {
				<p class="card-scientific">{ s.Species.ScientificName }</p>
			}
			<p class="card-place">{ place(s.Location) }</p>
			<div class="card-observer"><span>Observed by</span><p>{ cmp.Or(s.RecordedBy, "Observer not recorded") }</p></div>
			if s.IndividualCount != nil {
				<p class="individuals">{ *s.IndividualCount } individuals recorded</p>
			}
		</div>
	</article>
}

func displayName(sp species.Species) string {
	return cmp.Or(sp.VernacularName, sp.CanonicalName, sp.ScientificName, "Unknown species")
}
func place(l sighting.Location) string {
	parts := []string{}
	for _, part := range []string{l.Locality, l.StateProvince, l.Country} {
		if part != "" {
			parts = append(parts, part)
		}
	}
	return cmp.Or(strings.Join(parts, ", "), "Location unknown")
}
func firstPhoto(media []sighting.Media) sighting.Media {
	for _, m := range media {
		if m.Type == "StillImage" && m.URL != "" {
			return m
		}
	}
	return sighting.Media{}
}
func SearchText(s sighting.Sighting) string {
	return strings.ToLower(strings.Join([]string{displayName(s.Species), s.Species.ScientificName, place(s.Location), s.RecordedBy}, " "))
}
