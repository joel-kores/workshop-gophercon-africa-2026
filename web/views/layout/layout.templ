package layout

type BaseProps struct{ Title string }

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Discover the magic of Kenya through wildlife sightings, extraordinary landscapes and a spirit of exploration."/>
			<meta name="theme-color" content="#173F35"/>
			<title>{ props.Title }</title>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			<header class="site-header wrap">
				<a class="brand" href="/" aria-label="Magical Kenya, home"><img src="/assets/images/logo.svg" alt="" width="46" height="46"/><span>magical kenya<small>A WORLD OF WONDER</small></span></a>
				<nav aria-label="Main navigation"><a href="/#experience">The experience</a><a href="/#sightings">Wildlife sightings</a><a class="nav-button" href="/#discover">Find your magic <span aria-hidden="true">↗</span></a></nav>
			</header>
			<main id="main">{ children... }
</main>
			<footer class="site-footer"><div class="wrap footer-inner"><a class="brand" href="/">magical kenya<small>A WORLD OF WONDER</small></a><p>Leave only footprints. Take a little wonder with you.</p><a href="/#sightings">Explore the wild ↗</a></div><div class="wrap footer-note">An independent Kenya wildlife experience · Sightings from GBIF · Not an official tourism or booking service</div></footer>
			<script src="/assets/js/app.js" defer></script>
		</body>
	</html>
}
