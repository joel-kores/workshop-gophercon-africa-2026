package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	@layout.Base(layout.BaseProps{Title: "Magical Kenya — A world of wonder"}) {
		<section class="hero" aria-labelledby="hero-title">
			<img class="hero-photo" src="https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2400&q=85" alt="Warm evening light over an African savannah landscape" fetchpriority="high"/>
			<div class="hero-shade"></div>
			<div class="hero-content wrap"><p class="eyebrow"><span></span> KENYA. MORE THAN A DESTINATION.</p><h1 id="hero-title">Some places stay<br/>with you.<br/><em>Kenya changes you.</em></h1><p class="hero-description">The hush before a lion’s roar. The warmth of a golden horizon. Step into a world that feels beautifully, wildly alive.</p><a class="button" href="#sightings">Explore the wild <span aria-hidden="true">↗</span></a></div>
			<div class="hero-bottom wrap"><span>0° 01′ S &nbsp; 37° 54′ E <small>A LITTLE CLOSER TO WONDER</small></span><a href="#experience">Scroll to discover ↓</a></div>
		</section>
		<section id="experience" class="intro wrap section"><div><p class="eyebrow">THIS IS YOUR CALL TO THE WILD</p><h2>Extraordinary by nature.<br/><em>Unforgettable by feeling.</em></h2></div><div class="intro-copy"><p>From open savannahs to mountain silhouettes, Kenya invites you to slow down, look closer, and rediscover your sense of wonder.</p><a class="text-link" href="#sightings">Meet the wildlife that makes it magical ↗</a></div></section>
		<section id="sightings" class="wildlife section">
			<div class="wrap">
				<div class="section-heading"><div><p class="eyebrow">ENCOUNTERS WORTH REMEMBERING</p><h2>The wild, <em>as witnessed.</em></h2></div><p>Real wildlife observations from Kenya.<br/>Every sighting has a story.</p></div>
				if len(sightings) == 0 {
					<div class="empty-state"><h3>The wild is waiting.</h3><p>No Kenya sightings are available yet. Return soon to discover new encounters.</p></div>
				} else {
					<form class="search-bar" role="search" hidden data-sighting-search><label for="animal-search">Find your moment</label><input id="animal-search" name="q" type="search" placeholder="Search animals, places or observers…" autocomplete="off"/><button type="reset">Clear</button><output id="search-count" aria-live="polite">{ len(sightings) } sightings</output></form>
					<ul class="sightings" id="sighting-list">
						for _, s := range sightings {
							<li data-search={ components.SearchText(s) }>@components.SightingCard(s)
</li>
						}
					</ul>
					<p class="empty-state" id="no-matches" hidden>No sightings match your search. Try another animal or place.</p>
					<p class="data-note">Showing up to 120 recent Kenya observations. Wildlife is wonderfully unpredictable; sightings are records, never promises.</p>
				}
			</div>
		</section>
		<section id="discover" class="invitation wrap section"><div class="invitation-art" aria-hidden="true"><span class="sun"></span><span class="mountain mountain-back"></span><span class="mountain"></span><span class="art-label">THE SPIRIT OF EXPLORATION</span></div><div><p class="eyebrow">LET CURIOSITY LEAD THE WAY</p><h2>Your next great story<br/>starts with <em>wonder.</em></h2><p>Follow an animal that fascinates you. Discover a place you’ve never heard of. Let these encounters be the beginning of your Kenya story.</p><a class="button" href="#sightings">Discover your Kenya <span aria-hidden="true">↗</span></a></div></section>
	}
}
